         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Approved driving instructor (ADI) part 3 test: marking sheet</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The report form used to mark your approved driving instructor (ADI) part 3 test, which assesses your ability to teach pupils.&#xD;&#xA;</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>Driver and Vehicle Standards Agency</rdf:li>
            </rdf:Bag>
         </dc:creator>
